# Copy to .env (never commit .env). Phase 1 needs no variables: the app works fully offline.
# Phase 2 (client — public values only, passed with --dart-define-from-file):
PISTAK_API_BASE_URL=https://api.example.com
# Server-only secrets live in the backend environment, never in the Flutter app:
# DATABASE_URL=postgres://...
# JWT_SECRET=...
# STT_API_KEY=...
