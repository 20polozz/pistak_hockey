# Copy to .env (never commit .env). The app works fully offline with no variables.
# Client — public values only, passed with --dart-define-from-file=.env:
PISTAK_API_URL=https://api.example.com
# Server-only secrets live in the backend environment, never in the Flutter app:
# PISTAK_JWT_SECRET=...        (>= 32 chars)
# PISTAK_DB=/data/pistak.sqlite
# PISTAK_ORIGINS=https://app.example.com
# PISTAK_STT_API_KEY=...       (optional: voice incidents -> text)
# PISTAK_STT_URL=...           (optional, OpenAI-compatible)
# PISTAK_STT_MODEL=whisper-1
